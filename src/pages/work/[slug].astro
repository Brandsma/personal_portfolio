---
import Base from '../../layouts/Base.astro';
import MdImage from '../../components/MdImage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('work');
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const allWork = await getCollection('work');
const item = allWork.find((w) => w.slug === slug);
if (!item) return Astro.redirect('/');

const { Content } = await item.render();

const cmdItems = [
  ...allWork.map((w) => ({ kind: 'work', title: w.data.title, href: `/work/${w.slug}` })),
  { kind: 'page', title: 'home', href: '/' },
];
---

<Base title={`${item.data.title} · abe brandsma`} description={item.data.note} cmdItems={cmdItems}>
  <main class="work-wrap">
    <div class="crumbs reveal d1">
      <a href="/">~</a><span class="sep">/</span>
      <a href="/#work">work</a><span class="sep">/</span>
      <span class="dim">{slug}</span>
    </div>

    <article class="reveal d2">
      <div class="work-head">
        <div class="work-meta">
          <span class="stat">{item.data.year}</span>
          <span class="tag">{item.data.tag}</span>
          <span>{item.data.venue}</span>
        </div>
        <h1 class="work-title">{item.data.title}</h1>
        <div class="dim" style="font-size:12.5px;margin-top:.4rem">{item.data.note}</div>
      </div>

      <div class="work-body">
        <Content components={{ img: MdImage }} />
      </div>

      <div style="margin-top:2.5rem">
        <a href="/#work" style="font-family:var(--mono);font-size:13px;color:var(--ink-2)"
          >← back to work</a
        >
      </div>
    </article>
  </main>
</Base>
