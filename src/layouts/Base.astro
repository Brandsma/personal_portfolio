---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  cmdItems?: Array<{ kind: string; title: string; href: string }>;
}

const {
  title = 'abe brandsma — ai research engineer',
  description = 'AI research engineer based in Utrecht, NL. Physics-informed ML, retrieval & graph systems, and the infrastructure that makes research production-ready.',
  cmdItems = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/"
          ><span class="caret">▌</span>abebrandsma<span class="dot">.com</span></a
        >
        <span class="clock" id="clock">--:-- UTC</span>
        <nav>
          <a href="/#work">work</a>
          <a href="/#writing">writing</a>
          <a href="/#about">about</a>
          <a href="/#contact">contact</a>
        </nav>
        <button
          class="theme-toggle"
          id="theme-toggle"
          aria-label="toggle theme"
          title="toggle dark/light">◐</button
        >
      </div>
    </header>

    <slot />

    <div class="cmd" id="cmd" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="cmd-box">
        <input
          id="cmd-input"
          placeholder="search work, writing, /about, /contact …"
          autocomplete="off"
          spellcheck="false"
        />
        <div class="cmd-results" id="cmd-results"></div>
        <div class="cmd-hint">
          <span><kbd>↑</kbd><kbd>↓</kbd> nav</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>

    <script define:vars={{ cmdItems }}>
      // Theme — apply before paint to avoid flash
      (function () {
        const saved = localStorage.getItem('portfolio_theme');
        if (saved) document.documentElement.setAttribute('data-theme', saved);
      })();

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('portfolio_theme', next);
      });

      // Live clock
      const clockEl = document.getElementById('clock');
      function tick() {
        if (!clockEl) return;
        clockEl.textContent = new Date().toISOString().slice(11, 16) + ' UTC · utrecht';
      }
      tick();
      setInterval(tick, 30_000);

      // Command palette
      const cmd = document.getElementById('cmd');
      const input = document.getElementById('cmd-input');
      const results = document.getElementById('cmd-results');

      if (cmd && input && results) {
        let sel = 0;
        const all = /** @type {Array<{kind:string,title:string,href:string}>} */ (cmdItems);

        function open() {
          cmd.classList.add('open');
          cmd.setAttribute('aria-hidden', 'false');
          input.value = '';
          render('');
          setTimeout(() => input.focus(), 30);
        }
        function close() {
          cmd.classList.remove('open');
          cmd.setAttribute('aria-hidden', 'true');
        }
        function render(q) {
          const ql = q.trim().toLowerCase();
          const hits = ql
            ? all.filter((x) => x.title.toLowerCase().includes(ql) || x.kind.includes(ql))
            : all.slice(0, 8);
          sel = 0;
          results.innerHTML = hits
            .map(
              (h, i) =>
                `<div class="item${i === 0 ? ' sel' : ''}" data-href="${h.href}">` +
                `<span class="kind">${h.kind}</span><span>${h.title}</span></div>`,
            )
            .join('');
        }
        function move(dir) {
          const items = results.querySelectorAll('.item');
          if (!items.length) return;
          items[sel]?.classList.remove('sel');
          sel = (sel + dir + items.length) % items.length;
          items[sel].classList.add('sel');
          items[sel].scrollIntoView({ block: 'nearest' });
        }
        function go() {
          const item = /** @type {HTMLElement|null} */ (results.querySelector('.item.sel'));
          if (item?.dataset.href) {
            window.location.href = item.dataset.href;
            close();
          }
        }

        document.addEventListener('keydown', (e) => {
          const isOpen = cmd.classList.contains('open');
          const tag = (document.activeElement?.tagName || '').toLowerCase();
          if (!isOpen && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k'))) {
            if (tag !== 'input' && tag !== 'textarea') {
              e.preventDefault();
              open();
            }
          } else if (e.key === 'Escape' && isOpen) {
            close();
          } else if (isOpen) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              move(1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              move(-1);
            } else if (e.key === 'Enter') {
              e.preventDefault();
              go();
            }
          }
        });
        input.addEventListener('input', (e) =>
          render(/** @type {HTMLInputElement} */ (e.target).value),
        );
        cmd.addEventListener('click', (e) => {
          if (e.target === cmd) close();
        });
        results.addEventListener('click', (e) => {
          const item = /** @type {HTMLElement|null} */ (
            e.target instanceof Element ? e.target.closest('.item') : null
          );
          if (item?.dataset.href) {
            window.location.href = item.dataset.href;
            close();
          }
        });
      }
    </script>
  </body>
</html>
