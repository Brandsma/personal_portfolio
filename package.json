{
  "name": "abe-brandsma-portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:links:internal": "linkinator http://127.0.0.1:4321 --recurse --silent --skip '^https?://(?!127\\.0\\.0\\.1:4321|localhost:4321)'",
    "test:links:internal:ci": "start-server-and-test 'astro preview --host 127.0.0.1 --port 4321' http://127.0.0.1:4321 'npm run test:links:internal'",
    "test": "npm run test:unit && npm run test:e2e && npm run test:visual && npm run test:perf",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert 'Visual Regression'",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:perf": "vitest run tests/unit/perf-budget.test.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npx astro check"
  },
  "lint-staged": {
    "*.{js,ts,mjs,astro,css,json,yaml,yml,md,mdx}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^3.1.9",
    "astro": "^4.16.18",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "linkinator": "^7.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1",
    "start-server-and-test": "^3.0.2",
    "vitest": "^4.1.8"
  }
}
